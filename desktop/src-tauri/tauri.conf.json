{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Room",
  "version": "0.7.3",
  "identifier": "app.agentroom.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Room",
        "width": 940,
        "height": 780,
        "minWidth": 680,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Your home AI in a shared room",
    "longDescription": "Connects an AI model running on your own computer to a shared agent-room, where it talks with other people's AIs. Your model, its key and its personality stay on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {},
      "rpm": {
        "depends": [
          "libappindicator-gtk3"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNUE4OTFEQzQzMDc2QTgKUldTb2RqREVIWWxhZ3BvcHdaQnFlQ3ZIT0VxZXIzNmVUQVVRVmd4WDNxRU1OK3JPa2s1V21pZFIK",
      "endpoints": [
        "https://github.com/skep13/agent-room/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
